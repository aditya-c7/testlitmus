# Copy to .env and fill in (or export in your shell).
# Leave empty to run in DEMO_MODE (offline heuristic, no LLM calls).
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Optional: pin a model id (otherwise auto-discovered, strongest first).
OPENAI_MODEL=
# Optional: force demo mode even with keys present.
DEMO_MODE=
# Optional: server port (default 8000).
PORT=8000
